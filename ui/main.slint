import { CheckBox, ComboBox, ListView } from "std-widgets.slint";

export struct LogLine {
    text: string,
    error: bool,
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <color> dot-color: #8a86a0;
    width: 108px;
    height: 30px;
    border-radius: 15px;
    background: #ffffffcc;
    border-width: 1px;
    border-color: #e8e5f2;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.dot-color;
        }
        Text {
            text: root.label;
            color: #4a4660;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 52px;
    border-radius: 14px;
    background: @linear-gradient(90deg, #7b61ff 0%, #5b8cff 100%);
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        text: root.label;
        color: white;
        font-size: 16px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DangerButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 52px;
    border-radius: 14px;
    background: #d94a4a;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        text: root.label;
        color: white;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 94px;
    height: 40px;
    border-radius: 10px;
    background: touch.has-hover && root.enabled
        ? (root.danger ? #fdeeee : #f2efff)
        : transparent;
    border-width: 1px;
    border-color: root.danger ? #f0c9c9 : #e6e2f2;
    opacity: root.enabled ? 1.0 : 0.4;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.danger ? #c23b3b : #4f4968;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TextLink inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> link-width: 74px;
    callback clicked();

    width: root.link-width;
    height: 24px;
    background: transparent;

    Text {
        text: root.label;
        color: root.active ? #5b4bd6 : #7a7590;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Affinity";
    preferred-width: 920px;
    preferred-height: 660px;
    min-width: 780px;
    min-height: 580px;
    background: @linear-gradient(140deg, #f8f6ff 0%, #eef4ff 55%, #fff4ef 100%);

    in-out property <string> state-text: "Checking system...";
    in-out property <string> distro-text: "-";
    in-out property <string> gpu-text: "-";
    in-out property <string> wine-text: "-";
    in-out property <string> deps-text: "-";
    in-out property <string> prefix-text: "-";
    in-out property <string> status-text: "";
    in-out property <[LogLine]> logs: [];
    in property <bool> installed: false;
    in property <bool> busy: false;
    in-out property <int> backend-index: 0;
    in-out property <bool> opencl-enabled: false;
    in-out property <bool> advanced-open: false;
    in-out property <bool> details-open: false;
    in-out property <bool> confirm-open: false;

    callback install-clicked();
    callback launch-clicked();
    callback update-clicked();
    callback repair-clicked();
    callback uninstall-clicked();

    VerticalLayout {
        padding-top: 28px;
        padding-bottom: 28px;
        padding-left: 40px;
        padding-right: 40px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 11px;
                background: @linear-gradient(135deg, #7b61ff 0%, #5b8cff 100%);
                Text {
                    text: "A";
                    color: white;
                    font-size: 20px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                spacing: 1px;
                alignment: center;
                Text {
                    text: "Affinity";
                    font-size: 18px;
                    font-weight: 700;
                    color: #211f33;
                }
                Text {
                    text: "Linux installer";
                    font-size: 11px;
                    color: #8a86a0;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Pill {
                label: root.busy ? "Working" : (root.installed ? "Installed" : "Ready");
                dot-color: root.busy ? #e0a23a : (root.installed ? #1f9d6a : #8a86a0);
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 22px;
            background: white;
            border-width: 1px;
            border-color: #ece9f6;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #28204a14;

            VerticalLayout {
                padding: 36px;
                spacing: 18px;

                Text {
                    text: root.installed ? "You're all set." : "Affinity, on Linux.";
                    font-size: 34px;
                    font-weight: 800;
                    color: #1d1b2e;
                }
                Text {
                    text: root.installed
                        ? "Affinity v3 is installed. Open it, or keep it up to date."
                        : "Install Affinity v3 in one click. Wine, graphics and the app are configured for you.";
                    font-size: 14px;
                    color: #6f6b85;
                    wrap: word-wrap;
                    width: 540px;
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.busy ? #e0a23a : (root.installed ? #1f9d6a : #b5b0c8);
                        }
                    }
                    Text {
                        text: root.busy && root.status-text != ""
                            ? root.status-text
                            : (root.installed ? "Ready to launch" : "Ready to install");
                        font-size: 12px;
                        color: #8a86a0;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                Rectangle { height: 1px; background: #f1eff8; }

                if root.installed : HorizontalLayout {
                    spacing: 10px;
                    PrimaryButton {
                        label: root.busy ? "Opening..." : "Open Affinity";
                        enabled: !root.busy;
                        horizontal-stretch: 1;
                        clicked => { root.launch-clicked(); }
                    }
                    GhostButton { label: "Update"; enabled: !root.busy; clicked => { root.update-clicked(); } }
                    GhostButton { label: "Repair"; enabled: !root.busy; clicked => { root.repair-clicked(); } }
                    GhostButton { label: "Uninstall"; danger: true; enabled: !root.busy; clicked => { root.confirm-open = true; } }
                }

                if !root.installed : PrimaryButton {
                    label: root.busy ? "Installing Affinity..." : "Install Affinity";
                    enabled: !root.busy;
                    clicked => { root.install-clicked(); }
                }

                Rectangle { vertical-stretch: 1; }

                if root.advanced-open : Rectangle {
                    background: #f8f7fd;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #efedf7;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text {
                            text: "ADVANCED";
                            font-size: 10px;
                            font-weight: 700;
                            color: #8a86a0;
                            letter-spacing: 1px;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "GPU backend";
                                width: 104px;
                                font-size: 12px;
                                color: #55516b;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: ["vkd3d (recommended)", "DXVK"];
                                current-index: root.backend-index;
                                selected(value) => { root.backend-index = value == "DXVK" ? 1 : 0; }
                            }
                            CheckBox {
                                text: "OpenCL support";
                                checked: root.opencl-enabled;
                                toggled => { root.opencl-enabled = self.checked; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: root.distro-text + "  ·  " + root.gpu-text;
                            font-size: 11px;
                            color: #8a86a0;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Wine " + root.wine-text + "  ·  " + root.deps-text;
                            font-size: 11px;
                            color: #8a86a0;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    TextLink {
                        label: root.advanced-open ? "Advanced −" : "Advanced +";
                        active: root.advanced-open;
                        clicked => { root.advanced-open = !root.advanced-open; }
                    }
                    TextLink {
                        label: root.details-open ? "Details −" : "Details +";
                        active: root.details-open;
                        link-width: 66px;
                        clicked => { root.details-open = !root.details-open; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.prefix-text;
                        font-size: 10px;
                        color: #a5a1b6;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 320px;
                        horizontal-alignment: right;
                    }
                }

                if root.details-open : Rectangle {
                    height: 150px;
                    background: #17161f;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Text {
                            text: "ACTIVITY";
                            color: #8b87a3;
                            font-size: 9px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for line in root.logs : Text {
                                text: line.text;
                                color: line.error ? #ff9d9d : #b9b4cf;
                                font-family: "monospace";
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        Text {
            text: "Requires a 64-bit Linux distribution with Vulkan support.";
            font-size: 10px;
            color: #a09cb3;
            horizontal-alignment: center;
        }
    }

    if root.confirm-open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #1d1b2e66;

        Rectangle {
            x: (root.width - 400px) / 2;
            y: (root.height - 236px) / 2;
            width: 400px;
            height: 236px;
            border-radius: 18px;
            background: white;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: #1d1b2e40;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Uninstall Affinity?";
                    font-size: 18px;
                    font-weight: 700;
                    color: #1d1b2e;
                }
                Text {
                    text: "This removes the app, its Wine prefix and desktop entries. Your Affinity files are not touched.";
                    font-size: 12px;
                    color: #6f6b85;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        label: "Cancel";
                        clicked => { root.confirm-open = false; }
                    }
                    DangerButton {
                        label: "Uninstall";
                        width: 120px;
                        height: 40px;
                        clicked => {
                            root.confirm-open = false;
                            root.uninstall-clicked();
                        }
                    }
                }
            }
        }
    }
}
